# ---------------------------------------------------------------------------
# CuePilot — environment template.
#   cp .env.example .env.local
#
# Both services are external. Leave either blank and that half of the app
# falls back to the fixtures in src/lib/data/ — nothing breaks, nothing blanks.
# ---------------------------------------------------------------------------

# Content service — artifacts, blocks, library, templates.
# Blank = serve fixtures.
NEXT_PUBLIC_API_URL=

# Generation service — AI pipeline runs and their SSE stage streams.
# Blank = the assistant panels render their scripted conversation.
NEXT_PUBLIC_AI_URL=
