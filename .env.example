# ---------------------------------------------------------------------------
# CuePilot frontend — environment template.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# The Cuepilot Lesson Engine base URL. One service: it does ingest, generation,
# rendering and edits, and emits the UI's JSON contract at /v1/*.
#
# This is the ONLY backend var the app reads. It MUST be set in every deployed
# environment (e.g. Vercel) — otherwise the browser falls back to
# http://localhost:3001, which a deployed HTTPS page cannot reach (blocked /
# CORS error). Leave blank locally to use the http://localhost:3001 default.
#
#   Deployed value:  https://cuepilot-lesson-engine.onrender.com
NEXT_PUBLIC_ENGINE_URL=

# Legacy alias — still honored as a fallback when NEXT_PUBLIC_ENGINE_URL is unset.
# NEXT_PUBLIC_API_URL=https://cuepilot-lesson-engine.onrender.com