# ---------------------------------------------------------------------------
# CuePilot frontend — environment template.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# The Cuepilot Lesson Engine base URL. One service: it does ingest, generation,
# rendering and edits, and emits the UI's JSON contract at /v1/*.
# Leave blank to use the local dev default (http://localhost:3001).
NEXT_PUBLIC_ENGINE_URL=
NEXT_PUBLIC_API_URL=https://cuepilot-lesson-engine.onrender.com